# deps
node_modules/
.yarn/*
!.yarn/patches
!.yarn/releases

# npm lockfiles — this is a Yarn (v1) workspaces repo; CI uses yarn --frozen-lockfile.
# An accidental `npm install` writes package-lock.json, which must not be committed.
package-lock.json
**/package-lock.json

# build output
lib/
dist/
*.tsbuildinfo

# example / expo
example/.expo/
example/dist/
example/web-build/
.expo/

# native
example/ios/
example/android/

# test / coverage
coverage/

# logs
*.log
npm-debug.*
yarn-debug.*
yarn-error.*

# os / editor
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
*.pem
.env*.local

# misc
.turbo/
