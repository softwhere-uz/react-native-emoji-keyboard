{
  "name": "@softwhere-uz/react-native-emoji-keyboard",
  "version": "0.4.0",
  "description": "Universal (iOS · Android · Web), New-Architecture-first emoji keyboard & reaction picker for React Native and Expo. Bundled Emoji 17.0 data, FlashList v2, deep theming, first-class web parity — one package, no extra data dependency.",
  "keywords": [
    "react-native",
    "expo",
    "emoji",
    "emoji-keyboard",
    "emoji-picker",
    "reaction-picker",
    "web",
    "new-architecture",
    "fabric",
    "flashlist"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/softwhere-uz/react-native-emoji-keyboard.git",
    "directory": "packages/react-native-emoji-keyboard"
  },
  "homepage": "https://github.com/softwhere-uz/react-native-emoji-keyboard#readme",
  "sideEffects": false,
  "source": "./src/index.ts",
  "react-native": "./src/index.ts",
  "main": "./lib/commonjs/index.js",
  "module": "./lib/module/index.js",
  "types": "./lib/typescript/commonjs/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./lib/typescript/module/index.d.ts",
        "default": "./lib/module/index.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/index.d.ts",
        "default": "./lib/commonjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "README.md",
    "MIGRATION.md",
    "LICENSE",
    "!src/**/__tests__",
    "!**/*.test.ts",
    "!**/*.test.tsx"
  ],
  "scripts": {
    "codegen": "node scripts/codegen.mjs",
    "build": "bob build",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "clean": "rimraf lib",
    "prepack": "bob build"
  },
  "peerDependencies": {
    "@shopify/flash-list": ">=2.0.0",
    "react": ">=18.0.0",
    "react-native": ">=0.74.0",
    "react-native-gesture-handler": ">=2.0.0",
    "react-native-reanimated": ">=3.0.0",
    "react-native-safe-area-context": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "react-native-gesture-handler": {
      "optional": true
    },
    "react-native-reanimated": {
      "optional": true
    },
    "react-native-safe-area-context": {
      "optional": true
    }
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@babel/preset-env": "^7.25.0",
    "@babel/preset-react": "^7.25.0",
    "@babel/preset-typescript": "^7.25.0",
    "@shopify/flash-list": "^2.3.2",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.0.0",
    "@types/jest": "^29.5.0",
    "@types/react": "^19.0.0",
    "babel-jest": "^29.7.0",
    "emojibase-data": "17.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-builder-bob": "^0.43.0",
    "react-native-safe-area-context": "~5.7.0",
    "rimraf": "^6.0.0"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "commonjs",
        {
          "esm": true
        }
      ],
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "publishConfig": {
    "access": "public"
  }
}
